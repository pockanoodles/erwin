{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": false
  },
  "include": [
    "src/worker/**/*.ts",
    "src/lib/erwin/job-sync-runner.ts",
    "src/lib/canvas/**/*.ts",
    "src/lib/caldav-calendar.ts",
    "src/lib/caldav-helpers.ts",
    "src/lib/caldav-interfaces.ts",
    "src/lib/caldav-ctag.ts",
    "src/lib/date-utils.ts",
    "src/lib/logger/**/*",
    "src/lib/prisma.ts",
    "src/types/calendar.ts"
  ],
  "exclude": ["node_modules"]
}
