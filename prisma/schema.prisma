// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // "native" serves this machine and the Docker image. The rest are the query
  // engines the desktop builds ship (macOS both arches from one runner, glibc
  // Linux on Debian- and RHEL-family OpenSSL, arm64 Linux, Windows);
  // scripts/desktop/stage.mjs keeps only the ones the target platform loads.
  binaryTargets = ["native", "darwin", "darwin-arm64", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConnectedAccount {
  id             String         @id @default(cuid())
  provider       String // "GOOGLE" | "OUTLOOK" | "CALDAV"
  email          String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  calendars      CalendarFeed[]
  // CalDAV specific fields
  caldavUrl      String? // Base URL for CalDAV server
  caldavUsername String? // Username for Basic Auth

  // User relationship
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  TaskProvider TaskProvider[]

  @@unique([userId, provider, email])
  @@index([userId])
}

/// A link to an external identity provider. Upstream stored the local password
/// hash here in `id_token`; Erwin keeps it on `User.passwordHash` instead, so
/// every column below means what its name says.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// bcrypt hash for password sign-in. Null for a user who has no password.
  /// Deliberately *not* covered by the credential-encryption extension: a hash
  /// needs no encryption, and encrypting it would break `compare()`.
  passwordHash String?

  role                 String                @default("user") // Possible values: "user", "admin"
  accounts             Account[]
  sessions             Session[]
  calendars            CalendarFeed[]
  autoScheduleSettings AutoScheduleSettings?
  userSettings         UserSettings?
  calendarSettings     CalendarSettings?
  notificationSettings NotificationSettings?
  integrationSettings  IntegrationSettings?
  dataSettings         DataSettings?
  tasks                Task[]
  projects             Project[]
  connectedAccounts    ConnectedAccount[]
  tags                 Tag[]
  taskProviders        TaskProvider[]
  TaskChange           TaskChange[]
  PasswordReset        PasswordReset[]
  rankerState          RankerState?
  goalCycles           GoalCycle[]
  goals                Goal[]
  courses              Course[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CalendarFeed {
  id                String            @id @default(uuid())
  name              String
  url               String? // Optional for local calendars
  type              String // "LOCAL", "GOOGLE", "OUTLOOK", "CALDAV"
  color             String? // Add back color field
  enabled           Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lastSync          DateTime?
  syncToken         String? // For incremental sync
  error             String?
  channelId         String? // Google Calendar webhook channel ID
  resourceId        String? // Google Calendar webhook resource ID
  channelExpiration DateTime? // When the webhook expires
  events            CalendarEvent[]
  userId            String?
  user              User?             @relation(fields: [userId], references: [id])
  accountId         String?
  account           ConnectedAccount? @relation(fields: [accountId], references: [id])
  // CalDAV specific fields
  caldavPath        String? // Path to the specific calendar on the server
  ctag              String? // CalDAV collection tag for change detection

  @@index([accountId])
}

model CalendarEvent {
  id              String       @id @default(uuid())
  feedId          String
  feed            CalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  externalEventId String? // External Calendar Event ID (Google, Outlook, etc.)
  title           String
  description     String?
  start           DateTime
  end             DateTime
  location        String?
  isRecurring     Boolean      @default(false)
  recurrenceRule  String?
  allDay          Boolean      @default(false)
  status          String?
  sequence        Int?
  created         DateTime?
  lastModified    DateTime?
  organizer       Json? // Stored as JSON { name?: string, email: string }
  attendees       Json? // Stored as JSON array of { name?: string, email: string, status?: string }
  /**
   * iCal TRANSP: OPAQUE (busy) or TRANSPARENT (free) — used by Erwin availability
   */
  transparency    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // New fields for hybrid approach
  isMaster         Boolean         @default(false) // True if this is a master event
  masterEventId    String? // Reference to the master event for instances
  masterEvent      CalendarEvent?  @relation("EventInstances", fields: [masterEventId], references: [id], onDelete: Cascade)
  instances        CalendarEvent[] @relation("EventInstances")
  recurringEventId String? // Google Calendar's recurring event ID

  // One row per (feed, external event, occurrence start).
  //
  // A recurring series is stored as one `isMaster` row plus its expanded instance
  // rows, all sharing the series UID in `externalEventId` and differing only by
  // `start` — so `start` must be part of the key or legitimate instances collide.
  // Conversely, the master row IS the series' first occurrence, so without `start`
  // in the key nothing stops an expansion from re-inserting that occurrence as a
  // second row (the bug this constraint closes).
  //
  // `externalEventId` is nullable and Postgres treats NULLs as distinct, so
  // locally-created events (no external identity) are deliberately unconstrained.
  @@unique([feedId, externalEventId, start])
  @@index([feedId])
  @@index([start, end])
  @@index([externalEventId])
  @@index([masterEventId])
  @@index([recurringEventId])
}

model Project {
  id               String            @id @default(cuid())
  name             String
  description      String?
  color            String?
  status           String            @default("active") // enum: 'active', 'archived'
  tasks            Task[]
  taskListMappings TaskListMapping[]

  // External sync fields
  externalId     String?
  externalSource String?
  lastSyncedAt   DateTime?

  // User relationship
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([externalId, externalSource])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?
  status      String // enum: 'todo', 'in_progress', 'completed'

  // Time Management
  dueDate       DateTime?
  startDate     DateTime? // When the task becomes active
  duration      Int? // estimated duration in minutes
  priority      String? // enum: 'high', 'medium', 'low', 'none'
  energyLevel   String? // enum: 'high', 'medium', 'low'
  preferredTime String? // enum: 'morning', 'afternoon', 'evening'

  // Auto-scheduling
  isAutoScheduled Boolean   @default(false)
  scheduleLocked  Boolean   @default(false)
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  scheduleScore   Float?
  lastScheduled   DateTime?
  postponedUntil  DateTime? // New field for postponing tasks

  // Organization
  tags Tag[]

  // Recurrence
  isRecurring       Boolean   @default(false)
  recurrenceRule    String?
  lastCompletedDate DateTime?
  completedAt       DateTime? // When the task was marked as completed

  // External Integration
  externalTaskId String?
  source         String?
  lastSyncedAt   DateTime?

  // Erwin: Canvas LMS + ranking (optional; tasks that predate Canvas sync omit these)
  lockAt              DateTime?
  unlockAt            DateTime?
  taskProviderId      String?
  taskProvider        TaskProvider? @relation(fields: [taskProviderId], references: [id], onDelete: SetNull)
  gradeImpactScore    Float?
  /**
   * Canvas: % of final course grade (0–100) for display; not pool-normalized
   */
  gradeWeightPercent  Float?
  urgencyTier         String?       @default("NONE")
  skipCount           Int           @default(0)
  lastSkippedAt       DateTime?
  timesSurfaced       Int           @default(0)
  courseId            String?
  courseName          String?
  assignmentGroupName String?
  pointsPossible      Float?
  groupWeight         Float?
  submissionTypes     Json?
  gradingType         String?
  submissionStatus    String?
  omitFromFinalGrade  Boolean       @default(false)
  category            String?       @default("PERSONAL")
  externalUrl         String?

  // Enhanced sync fields
  externalListId    String? // The external list/folder ID this task belongs to
  externalCreatedAt DateTime? // When the task was created in the external system
  externalUpdatedAt DateTime? // When the task was last updated in the external system
  syncStatus        String? // 'synced', 'pending', 'error', etc.
  syncError         String? // Error message if sync failed
  syncHash          String? // Hash of task data for detecting changes
  skipSync          Boolean   @default(false) // Flag to skip syncing this task

  // One-level subtasks. Children are checklist items, not Focus/scheduler
  // candidates. Deleting the parent cascades. Canvas sync never writes these.
  parentTaskId String?
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]  @relation("TaskSubtasks")
  order        Int?

  // Change tracking relation
  changes TaskChange[]

  interactions TaskInteraction[]

  // User relationship
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  // Erwin v3: tasks link to any number of goals/subgoals through TaskGoalLink
  goalLinks   TaskGoalLink[]
  /**
   * Set once a person picks this task's goal by hand; the goal rules (src/lib/erwin/goal-rules.ts) then leave its links alone.
   */
  goalsPinned Boolean        @default(false)

  /**
   * Canvas rubric criteria as Canvas returns them (`assignment.rubric`); null when the assignment has none.
   */
  rubric           Json?
  /**
   * Course materials this task needs — its module's files/pages and anything its description links to.
   */
  materialLinks    TaskMaterialLink[]
  /**
   * The gradebook row behind a Canvas task: score, feedback, quiz rules.
   */
  courseAssignment CourseAssignment?

  @@index([status])
  @@index([dueDate])
  @@index([startDate])
  @@index([priority])
  @@index([projectId])
  @@index([isRecurring])
  @@index([isAutoScheduled])
  @@index([scheduledStart, scheduledEnd])
  @@index([externalTaskId])
  @@index([source])
  @@index([postponedUntil])
  @@index([userId])
  @@index([externalTaskId, source])
  @@index([syncStatus])
  @@index([externalListId])
  @@index([taskProviderId])
  @@index([urgencyTier])
  @@index([parentTaskId, order])
}

/**
 * Erwin v2.2: a two-month planning block. One active at a time per user; mirrors how Kaito already plans the year.
 */
model GoalCycle {
  id         String   @id @default(cuid())
  theme      String
  /**
   * The hex's Build: 2–3 stat keys being pushed this cycle. Vocabulary in src/lib/erwin/stats.ts (mirrors ops/brain _map.md).
   */
  focusStats String[] @default([])
  startDate  DateTime
  endDate    DateTime
  status     String   @default("active") // enum: 'active' | 'completed' | 'archived'

  goals Goal[]

  // User relationship
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/**
 * Erwin v2.2: a goal within a cycle. Goal-linked tasks get an importance signal parallel to Task.gradeImpactScore.
 */
model Goal {
  id               String  @id @default(cuid())
  title            String
  whyItMatters     String? // the "why it matters" — surfaced in briefing
  definitionOfDone String? // what "done" looks like for this goal
  status           String  @default("active") // enum: 'active' | 'done' | 'dropped'
  /**
   * Erwin: importance signal (0–100) parallel to Task.gradeImpactScore; feeds Stage 1 ranking
   */
  importanceScore  Float?  @default(50)

  /**
   * Manual list position within the cycle (0 = top). Ties fall back to isBoss, then importance.
   */
  sortOrder  Int       @default(0)
  /**
   * Stat keys this goal develops (mirrors the vault goal's `develops:` frontmatter; vocabulary in src/lib/erwin/stats.ts).
   */
  develops   String[]  @default([])
  /**
   * Boss = dated, pass/fail deliverable for the hex (ops pays 5 runes on the kill).
   */
  isBoss     Boolean   @default(false)
  targetDate DateTime?

  /**
   * Goals-sync projection identity: "venture:<slug>" for a vault Lord, "venture:<slug>#boss:<name-slug>"
   * for a vault boss. NULL = hand-made in erwin; the pump only ever touches non-NULL (venture:) rows.
   */
  externalId String?

  /**
   * Lord: task sources it claims (the vault goal's `sources:` frontmatter, e.g. ["CANVAS"]) — every task with one of these sources links to it.
   */
  taskSources        String[] @default([])
  /**
   * Boss: the Canvas assignment id the vault boss names (`canvas: <id>`). The bound task's due date and submission win over the vault's.
   */
  canvasAssignmentId String?

  cycleId String
  cycle   GoalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  // Goal DAG: a goal can feed multiple parents and have multiple children, all within one cycle
  parentLinks GoalLink[] @relation("GoalLinkChild")
  childLinks  GoalLink[] @relation("GoalLinkParent")

  taskLinks TaskGoalLink[]

  // User relationship
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, externalId])
  @@index([cycleId])
  @@index([userId])
  @@index([status])
}

/**
 * Erwin v3: goal→goal DAG edge. Both ends must live in the same cycle; cycle-free enforced at the API layer.
 */
model GoalLink {
  id       String @id @default(cuid())
  parentId String
  parent   Goal   @relation("GoalLinkParent", fields: [parentId], references: [id], onDelete: Cascade)
  childId  String
  child    Goal   @relation("GoalLinkChild", fields: [childId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentId, childId])
  @@index([childId])
}

/**
 * Erwin v3: task↔goal many-to-many — a task can serve several goals/subgoals.
 */
model TaskGoalLink {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, goalId])
  @@index([goalId])
}

/**
 * Erwin: a mirrored Canvas course — its materials, gradebook, announcements and
 * inbox. Canvas stays the source of truth — every row here is rebuilt by sync
 * and pruned when Canvas drops it. Tasks keep their denormalized
 * courseId/courseName (the Canvas id), which matches `canvasId` here.
 */
model Course {
  id                String    @id @default(cuid())
  canvasId          String
  code              String?
  name              String
  termName          String?
  syllabusHtml      String?
  htmlUrl           String?
  /**
   * Last sync of any kind: gradebook, announcements and module structure, every background tick.
   */
  lastSyncedAt      DateTime?
  /**
   * Last full materials pass, which re-reads every page body and file's metadata (a few times a day).
   */
  materialsSyncedAt DateTime?

  /**
   * Canvas's own course grade for this student: `current` counts graded work only, `final` counts ungraded work as zero. Null when the course hides totals.
   */
  currentScore      Float?
  currentGrade      String?
  finalScore        Float?
  finalGrade        String?
  /**
   * Letter cutoffs as Canvas sends them, [[letter, lowest fraction]] best first. Null unless Canvas shows this course in letters.
   */
  gradingScheme     Json?
  /**
   * Assignment groups are weighted (`weight` is % of the grade); otherwise the grade is total points.
   */
  applyGroupWeights Boolean   @default(false)
  /**
   * Set by the first sync that recorded this course. What existed before it is history, so it never becomes activity.
   */
  activitySince     DateTime?

  modules          CourseModule[]
  materials        CourseMaterial[]
  assignmentGroups CourseAssignmentGroup[]
  assignments      CourseAssignment[]
  announcements    CourseAnnouncement[]
  conversations    CourseConversation[]
  activity         CourseActivity[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, canvasId])
}

/**
 * Erwin: one Canvas module — usually a week or a unit — in Canvas order.
 */
model CourseModule {
  id       String    @id @default(cuid())
  canvasId String
  name     String
  position Int
  unlockAt DateTime?

  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials CourseMaterial[]

  @@unique([courseId, canvasId])
}

/**
 * Erwin: one thing a student can open. A module item ("item:<id>"), a file a
 * module page links to ("file:<id>" with `parentId` = that page), or a file or
 * page reached only from an assignment, announcement or the syllabus
 * ("file:<id>", "page:<slug>", no module). Keyed by item rather than content
 * because Canvas reuses the same file across modules; the on-disk cache is
 * keyed by `fileCanvasId`, so the bytes are stored once.
 */
model CourseMaterial {
  id        String  @id @default(cuid())
  canvasRef String
  kind      String // enum: FILE | PAGE | EXTERNAL_URL | EXTERNAL_TOOL | ASSIGNMENT | QUIZ | DISCUSSION | SUBHEADER
  title     String
  position  Int?
  indent    Int     @default(0)
  htmlUrl   String?
  /**
   * Canvas withheld the content (unpublished, prerequisite, not unlocked yet).
   */
  locked    Boolean @default(false)

  /**
   * PAGE: the page's URL slug (what assignment descriptions link by) and its
   * body as Canvas returns it.
   */
  pageSlug String?
  bodyHtml String?

  /**
   * FILE: metadata plus the local cache. `localPath` is null until downloaded; `downloadError` says why it isn't.
   */
  fileCanvasId  String?
  fileName      String?
  contentType   String?
  sizeBytes     Int?
  fileUpdatedAt DateTime?
  localPath     String?
  downloadError String?

  /**
   * ASSIGNMENT/QUIZ/DISCUSSION: the backing Canvas assignment id (= Task.externalTaskId), when graded.
   */
  assignmentCanvasId String?

  lastSyncedAt DateTime

  courseId  String
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId  String?
  module    CourseModule?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  /**
   * The module page this file was reached through (SCHM wraps its slides in pages). Listed under it.
   */
  parentId  String?
  parent    CourseMaterial?    @relation("MaterialChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  CourseMaterial[]   @relation("MaterialChildren")
  taskLinks TaskMaterialLink[]
  activity  CourseActivity[]

  @@unique([courseId, canvasRef])
  @@index([moduleId])
  @@index([parentId])
  @@index([assignmentCanvasId])
  @@index([fileCanvasId])
  @@index([pageSlug])
}

/**
 * Erwin: task ↔ material, with why they're linked.
 */
model TaskMaterialLink {
  id         String         @id @default(cuid())
  /**
   * enum: MODULE (same module as the assignment) | DESCRIPTION (linked from the assignment text)
   */
  reason     String
  taskId     String
  task       Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  materialId String
  material   CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([taskId, materialId])
  @@index([materialId])
}

/**
 * Erwin: a Canvas assignment group — a gradebook category, with its weight and drop rules.
 */
model CourseAssignmentGroup {
  id          String             @id @default(cuid())
  canvasId    String
  name        String
  position    Int
  /**
   * % of the course grade, when the course weights its groups.
   */
  weight      Float?
  dropLowest  Int                @default(0)
  dropHighest Int                @default(0)
  /**
   * Canvas assignment ids the drop rules never drop.
   */
  neverDrop   String[]           @default([])
  courseId    String
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments CourseAssignment[]

  @@unique([courseId, canvasId])
}

/**
 * Erwin: every assignment in a live course with this student's submission —
 * the gradebook. Tasks are the actionable subset (`taskId`); this table also
 * keeps what isn't a task: participation grades, posted final grades, work
 * graded before Erwin first saw it.
 */
model CourseAssignment {
  id                  String    @id @default(cuid())
  canvasId            String
  name                String
  position            Int?
  dueAt               DateTime?
  unlockAt            DateTime?
  lockAt              DateTime?
  pointsPossible      Float?
  gradingType         String?
  submissionTypes     String[]  @default([])
  omitFromFinalGrade  Boolean   @default(false)
  htmlUrl             String?
  /**
   * Classic quiz settings: minutes (null = untimed), attempts (-1 = unlimited), and whether it needs Respondus LockDown Browser.
   */
  quizTimeLimit       Int?
  quizAllowedAttempts Int?
  quizQuestionCount   Int?
  lockdownBrowser     Boolean   @default(false)

  /**
   * This student's submission as Erwin reads it: unsubmitted | missing (past due, Canvas still takes it) | missed (closed, never submitted) | submitted | pending_review | graded | excused
   */
  state            String    @default("unsubmitted")
  submittedAt      DateTime?
  attempt          Int?
  late             Boolean   @default(false)
  secondsLate      Int?
  pointsDeducted   Float?
  score            Float?
  grade            String?
  gradedAt         DateTime?
  postedAt         DateTime?
  /**
   * Class statistics, when the instructor shares them: { mean, min, max, median, lower_q, upper_q }.
   */
  scoreStatistics  Json?
  /**
   * Comments on the submission, oldest first: [{ id, author, body, createdAt }].
   */
  comments         Json?
  /**
   * Rubric marks keyed by criterion id: { points, rating_id, comments }.
   */
  rubricAssessment Json?

  lastSyncedAt DateTime
  courseId     String
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId      String?
  group        CourseAssignmentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  taskId       String?                @unique
  task         Task?                  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  activity     CourseActivity[]

  @@unique([courseId, canvasId])
  @@index([groupId])
}

/**
 * Erwin: a course announcement. The body is raw Canvas HTML — sanitize it when rendering.
 */
model CourseAnnouncement {
  id           String           @id @default(cuid())
  canvasId     String
  title        String
  bodyHtml     String?
  author       String?
  postedAt     DateTime
  htmlUrl      String?
  /**
   * Canvas's own read flag at the last sync. Erwin reads it and never writes it back.
   */
  readInCanvas Boolean          @default(false)
  lastSyncedAt DateTime
  courseId     String
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activity     CourseActivity[]

  @@unique([courseId, canvasId])
  @@index([courseId, postedAt])
}

/**
 * Erwin: a Canvas Inbox thread sent in a live course — instructor messages
 * like a schedule change.
 */
model CourseConversation {
  id            String           @id @default(cuid())
  canvasId      String
  subject       String
  lastMessageAt DateTime
  messageCount  Int
  /**
   * Oldest first: [{ id, author, body, createdAt }]. Canvas stores message bodies as plain text.
   */
  messages      Json
  lastSyncedAt  DateTime
  courseId      String
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activity      CourseActivity[]

  @@unique([courseId, canvasId])
}

/**
 * Erwin: something that changed in a course since the last sync — a new
 * announcement, file, grade or due date. The UI marks it seen; ops pushes it
 * to the hub. Never written for what already existed at a course's first sync.
 */
model CourseActivity {
  id             String              @id @default(cuid())
  /**
   * enum: ANNOUNCEMENT | MESSAGE | MATERIAL_NEW | MATERIAL_UPDATED | SYLLABUS_CHANGED | ASSIGNMENT_NEW | DUE_CHANGED | GRADE_POSTED | GRADE_CHANGED | FEEDBACK | MISSING
   */
  kind           String
  /**
   * The thing, named the way a person would: "Exam 1 Things to Know", "Chapter 7 slides.pptx".
   */
  title          String
  /**
   * What happened to it, when the kind alone doesn't say: "92 / 100", "Oct 24 → Oct 27".
   */
  detail         String?
  /**
   * One row per event, e.g. "announcement:<id>", "grade:<assignment id>:<graded at>".
   */
  dedupeKey      String
  /**
   * When it happened in Canvas, if Canvas says (posted, graded); otherwise when sync noticed.
   */
  occurredAt     DateTime
  seenAt         DateTime?
  createdAt      DateTime            @default(now())
  courseId       String
  course         Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     CourseAssignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  materialId     String?
  material       CourseMaterial?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  announcementId String?
  announcement   CourseAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   CourseConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([courseId, dedupeKey])
  @@index([courseId, createdAt])
  @@index([createdAt])
  @@index([seenAt])
  @@index([assignmentId])
  @@index([materialId])
}

/**
 * Erwin: implicit feedback for learning-to-rank (Done / Skip / Surfaced)
 */
model TaskInteraction {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action      String // COMPLETED | SKIPPED | SURFACED
  contextJson Json
  sessionId   String
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([sessionId])
  @@index([createdAt])
}

/**
 * Erwin: per-user learned ranker weights and blend metadata
 */
model RankerState {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightVector           Json
  learningRate           Float    @default(0.01)
  totalUpdates           Int      @default(0)
  alpha                  Float    @default(0.8)
  completionRate         Float?
  avgSkipsBeforeComplete Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
}

model Tag {
  id    String  @id @default(cuid())
  name  String
  color String?
  tasks Task[]

  // User relationship
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@unique([name, userId])
  @@index([name])
  @@index([userId])
}

model AutoScheduleSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Work Hours
  workDays      String @default("[]") // JSON string of numbers 0-6
  workHourStart Int // 0-23
  workHourEnd   Int // 0-23

  // Preferences
  selectedCalendars String @default("[]") // JSON string of calendar IDs
  bufferMinutes     Int    @default(15)

  // Energy Level Mappings
  highEnergyStart   Int? // 0-23
  highEnergyEnd     Int? // 0-23
  mediumEnergyStart Int? // 0-23
  mediumEnergyEnd   Int? // 0-23
  lowEnergyStart    Int? // 0-23
  lowEnergyEnd      Int? // 0-23

  // Project Settings
  groupByProject Boolean @default(false)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme        String   @default("system") // "light", "dark", "system"
  defaultView  String   @default("week") // "day", "week", "month", "agenda"
  timeZone     String
  weekStartDay String   @default("sunday") // "monday", "sunday"
  timeFormat   String   @default("12h") // "12h", "24h"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model CalendarSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCalendarId   String?
  workingHoursEnabled Boolean  @default(true)
  workingHoursStart   String   @default("09:00") // HH:mm format
  workingHoursEnd     String   @default("17:00") // HH:mm format
  workingHoursDays    String   @default("[1,2,3,4,5]") // JSON string of numbers 0-6
  defaultDuration     Int      @default(60) // minutes
  defaultColor        String   @default("#3b82f6")
  defaultReminder     Int      @default(30) // minutes
  refreshInterval     Int      @default(5) // minutes
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

model NotificationSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications    Boolean  @default(true)
  eventInvites          Boolean  @default(true)
  eventUpdates          Boolean  @default(true)
  eventCancellations    Boolean  @default(true)
  eventReminders        Boolean  @default(true)
  defaultReminderTiming String   @default("[30]") // JSON string of minutes before event
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model IntegrationSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleCalendarEnabled   Boolean  @default(true)
  googleCalendarAutoSync  Boolean  @default(true)
  googleCalendarInterval  Int      @default(5) // minutes
  outlookCalendarEnabled  Boolean  @default(true)
  outlookCalendarAutoSync Boolean  @default(true)
  outlookCalendarInterval Int      @default(5) // minutes
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
}

model DataSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoBackup     Boolean  @default(true)
  backupInterval Int      @default(7) // days
  retainDataFor  Int      @default(365) // days
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model SystemSettings {
  id                  String   @id @default(cuid())
  googleClientId      String?
  googleClientSecret  String?
  outlookClientId     String?
  outlookClientSecret String?
  outlookTenantId     String?
  logLevel            String   @default("none") // none, debug, info, warn, error
  logRetention        Json? // Retention periods per log level
  logDestination      String   @default("db") // db, file, both
  publicSignup        Boolean  @default(false) // Whether public signup is enabled
  disableHomepage     Boolean  @default(false) // Whether to disable the homepage and redirect to login/calendar
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Log {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String // INFO, WARN, ERROR, DEBUG
  message   String   @db.Text
  metadata  Json? // For structured data
  source    String? // Component/service name
  expiresAt DateTime // For TTL-based cleanup

  @@index([timestamp, level])
  @@index([expiresAt])
  @@index([source, level])
}

// New models for task synchronization
model TaskProvider {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                String // 'outlook', 'google', 'CANVAS', etc.
  name                String
  enabled             Boolean           @default(true)
  syncEnabled         Boolean           @default(true)
  syncInterval        String            @default("hourly") // 'hourly', 'daily', 'manual'
  /**
   * Erwin: polling interval in minutes (Canvas default 15 — new announcements, files and grades shouldn't wait hours)
   */
  syncIntervalMinutes Int?              @default(15)
  /**
   * Erwin: Canvas base URL or other provider base
   */
  serverUrl           String?
  lastSyncedAt        DateTime?
  accessToken         String?
  refreshToken        String?
  expiresAt           DateTime?
  accountId           String? // References a ConnectedAccount
  account             ConnectedAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  defaultProjectId    String? // Default project for tasks without a list mapping
  settings            Json? // Provider-specific settings
  mappings            TaskListMapping[]
  error               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  TaskChange          TaskChange[]
  tasks               Task[]

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

model TaskListMapping {
  id               String       @id @default(cuid())
  providerId       String
  provider         TaskProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalListId   String // ID of the external task list
  externalListName String // Name of the external task list
  direction        String       @default("incoming") // 'incoming', 'outgoing', 'bidirectional'
  isDefault        Boolean      @default(false)
  syncEnabled      Boolean      @default(true)
  isAutoScheduled  Boolean      @default(true)
  lastSyncedAt     DateTime?
  syncStatus       String?
  lastError        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  TaskChange       TaskChange[]

  @@unique([providerId, projectId])
  @@unique([providerId, externalListId])
  @@index([providerId])
  @@index([projectId])
  @@index([externalListId])
}

// New model for task change tracking
model TaskChange {
  id         String           @id @default(cuid())
  taskId     String? // ID of the task that changed
  task       Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  providerId String? // ID of the provider if this is related to a sync
  provider   TaskProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  mappingId  String? // ID of the mapping if this is related to a list sync
  mapping    TaskListMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  changeType String // 'CREATE', 'UPDATE', 'DELETE'
  changeData Json? // The actual changes, as a diff
  synced     Boolean          @default(false) // Whether this change has been synced
  timestamp  DateTime         @default(now())
  userId     String // User who made the change
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@index([taskId])
  @@index([providerId])
  @@index([mappingId])
  @@index([changeType])
  @@index([synced])
  @@index([timestamp])
  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}
