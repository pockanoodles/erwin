# Database Configuration
# Host machine (npm run dev / prisma / worker on your laptop): use localhost — ports are published from Compose.
DATABASE_URL="postgresql://fluid:fluid@localhost:5432/fluid_calendar"
# Inside Docker Compose only (app container → db service): use host `db` instead of localhost.
# DATABASE_URL="postgresql://fluid:fluid@db:5432/fluid_calendar"

# NextAuth Configuration
# Use domain in production, localhost for development
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Signs session JWTs. Required — the app refuses to start without it.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Encrypts credential columns at rest: OAuth tokens, the Canvas token, the
# CalDAV password, third-party API keys (see DATAFLOW.md). Must decode to
# exactly 32 bytes. Generate with: openssl rand -base64 32
#
# Lose this and every stored credential becomes unreadable — you would have to
# reconnect each integration. Change it and you must re-run the backfill
# (`npm run credentials:encrypt`) with the old key still available.
ERWIN_SECRET_KEY=


# BullMQ worker (`npm run build:worker` && `npm run start:worker` from repo root)
# Worker loads this file via dotenv; Prisma needs DATABASE_URL above (localhost when Postgres is on the host).
REDIS_URL=
# Set to "inprocess" to run background sync on a timer inside the app instead of
# the BullMQ worker, which lets a single container run without Redis.
ERWIN_SCHEDULER=
# Tick interval for Canvas + CalDAV polling (ms). Default 900000 (15 min).
ERWIN_BACKGROUND_SYNC_INTERVAL_MS=
# Minimum gap between CalDAV feed syncs when unchanged (minutes). Default 15.
ERWIN_CALDAV_POLL_INTERVAL_MINUTES=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google OAuth (Google Calendar integration). Leave blank to disable Google sign-in / calendar.
# Canvas and CalDAV credentials are entered in-app and stored in the DB, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft (Calendar and To Do). Leave blank to disable Outlook sign-in.
# Register a multitenant Azure app that also allows personal Microsoft accounts.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# Where Canvas course files are saved. Default ~/.erwin/materials
ERWIN_MATERIALS_DIR=
# Canvas files above this size are listed but not downloaded. Default 100
ERWIN_MATERIALS_MAX_FILE_MB=
