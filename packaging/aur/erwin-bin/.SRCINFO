pkgbase = erwin-bin
	pkgdesc = A field-watch-plain secretary for your calendar, your tasks and whatever else you track
	pkgver = {{VERSION}}
	pkgrel = 1
	url = https://kaitosoeno.com/erwin
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = alsa-lib
	depends = gtk3
	depends = libnotify
	depends = libxss
	depends = libxtst
	depends = nss
	depends = xdg-utils
	provides = erwin
	conflicts = erwin
	options = !strip
	options = !debug
	options = !emptydirs
	source = LICENSE-{{VERSION}}::https://raw.githubusercontent.com/pockanoodles/erwin/v{{VERSION}}/LICENSE
	source = erwin-{{VERSION}}.png::https://raw.githubusercontent.com/pockanoodles/erwin/v{{VERSION}}/desktop/build/icon.png
	sha256sums = {{SHA256_LICENSE}}
	sha256sums = {{SHA256_ICON}}
	source_x86_64 = erwin-{{VERSION}}-x64.tar.gz::https://github.com/pockanoodles/erwin/releases/download/v{{VERSION}}/Erwin-{{VERSION}}-linux-x64.tar.gz
	sha256sums_x86_64 = {{SHA256_LINUX_X64}}
	source_aarch64 = erwin-{{VERSION}}-arm64.tar.gz::https://github.com/pockanoodles/erwin/releases/download/v{{VERSION}}/Erwin-{{VERSION}}-linux-arm64.tar.gz
	sha256sums_aarch64 = {{SHA256_LINUX_ARM64}}

pkgname = erwin-bin
